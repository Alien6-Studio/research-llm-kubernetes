[Unit]
Description=Alien6 study CPU inference server
Requires=nftables.service
After=network-online.target nftables.service
Wants=network-online.target
ConditionVirtualization=lxc
ConditionHost=a6-ollama-study
ConditionPathExists=/etc/alien6-research/ready-to-serve
ConditionPathExists=/opt/ollama/bin/ollama

[Service]
Type=simple
User=alien6-study
Group=alien6-study
WorkingDirectory=/var/lib/alien6-ollama
Environment=HOME=/var/lib/alien6-ollama
# The operator records model scheduler settings here before manual startup.
EnvironmentFile=/etc/alien6-research/ollama.env
ExecStart=/usr/bin/env OLLAMA_HOST=127.0.0.1:11435 OLLAMA_MODELS=/var/lib/alien6-ollama/models /opt/ollama/bin/ollama serve
Restart=no
CPUAccounting=yes
CPUWeight=100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alien6-ollama
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
